{
  "name": "voicepilot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup:pi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-pi.ps1",
    "setup:speech": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-speech.ps1",
    "setup:speech:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-speech-gpu-runtime.ps1",
    "diagnose:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/diagnose-gpu.ps1",
    "setup:file-search": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-file-search.ps1",
    "setup:file-search:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-file-search.ps1 -Gpu",
    "setup:laya": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-laya.ps1",
    "start:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-browser-cdp.ps1",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "test:speech": "python -m unittest discover -s services/speech -p test_*.py -v",
    "test:file-search": "python -m unittest discover -s services/file_search -p test_*.py -v",
    "test": "node --test scripts/dev.test.mjs scripts/install-windows.test.mjs scripts/package-windows.test.mjs scripts/file-search-gpu-setup.test.mjs scripts/speech-gpu-setup.test.mjs && npm --prefix apps/bridge test && npm run test:speech && npm run test:file-search",
    "build": "npm --prefix apps/bridge run build && npm --prefix apps/ui run build"
  },
  "dependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}

