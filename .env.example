# Local-only bridge settings. Do not place secrets in the UI configuration.
VOICEPILOT_HOST=127.0.0.1
VOICEPILOT_PORT=8787
VOICEPILOT_UI_ORIGIN=http://127.0.0.1:5173
VITE_BRIDGE_URL=http://127.0.0.1:8787
VOICEPILOT_STT_ENABLED=0
VOICEPILOT_FILE_SEARCH_ENABLED=0
VOICEPILOT_GLOBAL_HOTKEY_ENABLED=0
# Optional Pi managed-install overrides; the current Windows user profile is detected automatically.
# VOICEPILOT_PI_AGENT_HOME=C:\Users\your-name\.pi\agent
# VOICEPILOT_PI_COMPUTER_USE_EXTENSION=C:\path\to\pi-computer-use\dist\index.js
# LLM selection defaults to local-first. Set to "kilocode" to always use KiloCode.
# The local provider/model settings remain available when VOICEPILOT_LLM_PROVIDER=local.
# VOICEPILOT_LLM_PROVIDER=kilocode
# VOICEPILOT_LOCAL_LLM_PROVIDER=ollama
# VOICEPILOT_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# VOICEPILOT_LOCAL_LLM_MODEL=qwen2.5-coder:7b
# Optional exact KiloCode model ID; otherwise VoicePilot chooses the first available KiloCode model.
# VOICEPILOT_KILOCODE_MODEL=
# faster-whisper model; large-v3 is the selected default and downloads on first use.
# VOICEPILOT_STT_MODEL=large-v3
# On memory allocation failure, faster-whisper switches to this smaller model; set empty to disable fallback.
VOICEPILOT_STT_FALLBACK_MODEL=base
# VOICEPILOT_STT_DEVICE=auto
# VOICEPILOT_STT_COMPUTE_TYPE=default
# Optional. Set by npm run setup:speech:gpu; used only in the speech worker process.
# VOICEPILOT_STT_CUDA_RUNTIME=
# VOICEPILOT_PYTHON=C:\\path\\to\\python.exe
# File search uses a separate local Python environment and per-user index/model storage.
# VOICEPILOT_FILE_SEARCH_PYTHON=C:\\path\\to\\python.exe
# VOICEPILOT_FILE_SEARCH_DEVICE=auto
# VOICEPILOT_DATA_DIR=C:\\Users\\your-name\\AppData\\Roaming\\VoicePilot
# Set to the local CDP endpoint of the browser you launch for VoicePilot (for example http://127.0.0.1:9222).
# The browser must be started with remote debugging enabled before VoicePilot can attach.
# VOICEPILOT_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222

